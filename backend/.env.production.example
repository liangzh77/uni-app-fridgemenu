# ===========================================
# Railway 生产环境配置模板
# 在 Railway Dashboard 中设置这些环境变量
# ===========================================

# 服务器配置（Railway 自动设置 PORT）
NODE_ENV=production

# ===========================================
# 数据库配置（使用 Railway MySQL 插件）
# Railway 会自动提供 MYSQL_URL，但我们需要分解使用
# ===========================================
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ===========================================
# Redis 配置（使用 Railway Redis 插件）
# ===========================================
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# ===========================================
# 阿里云配置（从你的阿里云控制台获取）
# ===========================================
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_REGION=cn-shanghai

# 通义千问 API（DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key

# 阿里云 OSS（图片存储，可选）
OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# CDN 配置（可选）
CDN_BUCKET=your_cdn_bucket
CDN_DOMAIN=https://cdn.yourdomain.com

# ===========================================
# 微信小程序配置
# ===========================================
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# ===========================================
# 安全配置
# ===========================================
JWT_SECRET=your_random_jwt_secret_at_least_32_chars
