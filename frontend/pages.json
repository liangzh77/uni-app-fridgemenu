{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "冰箱菜单",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/recipe/recommend",
      "style": {
        "navigationBarTitleText": "推荐菜谱",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/recipe/detail",
      "style": {
        "navigationBarTitleText": "菜谱详情",
        "navigationStyle": "custom",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/favorites/index",
      "style": {
        "navigationBarTitleText": "我的收藏",
        "enablePullDownRefresh": true
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "冰箱菜单",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F8F8F8",
    "app-plus": {
      "background": "#EFEFF4"
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#4CAF50",
    "borderStyle": "black",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/favorites/index",
        "text": "收藏",
        "iconPath": "static/images/tab-favorite.png",
        "selectedIconPath": "static/images/tab-favorite-active.png"
      },
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/images/tab-home.png",
        "selectedIconPath": "static/images/tab-home-active.png"
      },
      {
        "pagePath": "pages/recipe/recommend",
        "text": "菜谱",
        "iconPath": "static/images/tab-recipe.png",
        "selectedIconPath": "static/images/tab-recipe-active.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  }
}
